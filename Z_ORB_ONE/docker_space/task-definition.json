{
  "family": "quant-trading-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::070747961467:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::070747961467:role/quantTradingTaskRole",
  "containerDefinitions": [
    {
      "name": "quant-trading",
      "image": "070747961467.dkr.ecr.ap-northeast-1.amazonaws.com/quant-trading:latest",
      "essential": true,
      "secrets": [
        {
          "name": "ESUN_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:070747961467:secret:quant/esun-password-EOUoGF"
        },
        {
          "name": "CERT_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:070747961467:secret:quant/cert-password-SDuUsi"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/quant-trading",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
